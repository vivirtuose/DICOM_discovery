# Copy to `.env` next to docker-compose.yml and adapt. No secrets live here.

# Image tag loaded on the NAS (docker load -i dicom-discovery-<version>-amd64.tar.gz)
DD_VERSION=0.11.1

# DICOM tree to scan — mounted READ-ONLY at /data inside the container.
DICOM_ROOT=/volume1/RADIO-AIDE_full/DICOM

# Where runs/, latest/, last_run.json and the index cache are written. Restrict access to
# this share: reports and CSVs contain patient identifiers and study dates.
OUTPUT_DIR=/volume1/qc/dicom-discovery

# Account the container runs as. It must be able to READ DICOM_ROOT and WRITE OUTPUT_DIR.
# Synology: `id <user>` over SSH (first DSM user is usually 1026, group "users" is 100).
PUID=1026
PGID=100

# Patient key: `dicom` (PatientID tag) or `folder` (top-level folder, e.g. study pseudonym
# "IC 003" when the PatientID tag holds the hospital MRN). Check with --dry-run first.
GROUP_BY=dicom

# Parallel header reads (I/O-bound; 4-8 suits a NAS, more rarely helps over SMB/NFS).
WORKERS=8
# Run folders kept under OUTPUT_DIR/runs/ (0 = keep all).
KEEP_RUNS=30

# Resource caps (the NAS keeps serving files while a scan runs).
MEM_LIMIT=3g
CPUS=2
TZ=Europe/Paris
